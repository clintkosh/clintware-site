{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "clintware-mail",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "mail.clintware.com", "custom_domain": true }
  ],
  "vars": {
    "MAIL_OWNER_EMAIL": "clint@clintware.com",
    "MAIL_FROM_ADDRESS": "clint@clintware.com",
    "FORWARD_COPY_TO": "clint.kosh@gmail.com"
  },
  "services": [
    { "binding": "MAILER", "service": "clintware-blog-newsletter" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MAILBOX", "class_name": "MailStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MailStore"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
