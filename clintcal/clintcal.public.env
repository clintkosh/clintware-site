# Non-secret ClintCal production defaults. Merge these values into runtime/.env.
NEXT_PUBLIC_WEBAPP_URL='https://meet.clintware.com'
NEXT_PUBLIC_WEBSITE_URL='https://meet.clintware.com'
NEXT_PUBLIC_EMBED_LIB_URL='https://meet.clintware.com/embed/embed.js'
NEXTAUTH_URL='https://meet.clintware.com'
ALLOWED_HOSTNAMES='"meet.clintware.com","localhost:3000"'
GOOGLE_WEBHOOK_URL='https://meet.clintware.com'
CALCOM_TELEMETRY_DISABLED='1'
NEXT_PUBLIC_APP_NAME='ClintCal'
NEXT_PUBLIC_COMPANY_NAME='Clintware'
NEXT_PUBLIC_DISABLE_SIGNUP='true'
NEXT_PUBLIC_SENDGRID_SENDER_NAME='Clintware'
CSP_POLICY='non-strict'

# Enable after Cloudflare Turnstile keys are present in the secret runtime environment.
# NEXT_PUBLIC_CLOUDFLARE_USE_TURNSTILE_IN_BOOKER='1'
