# Copy to .stack.env on the self-hosted machine. Never commit the real file.
POSTGRES_USER=clintcal
POSTGRES_PASSWORD=replace-with-long-random-secret
POSTGRES_DB=clintcal
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
CALENDSO_ENCRYPTION_KEY=replace-with-32-byte-encryption-key
JWT_SECRET=replace-with-long-random-secret
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Optional legal pages
NEXT_PUBLIC_WEBSITE_TERMS_URL=https://clintware.com/terms
NEXT_PUBLIC_WEBSITE_PRIVACY_POLICY_URL=https://clintware.com/privacy
