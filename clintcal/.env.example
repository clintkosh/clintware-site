# ClintCal operator settings
CLINTCAL_PUBLIC_URL=https://meet.clintware.com
CLINTCAL_API_BASE_URL=https://meet.clintware.com/v2
CLINTCAL_API_KEY=
# API v2 requires an explicit version. Keep this configurable so upstream version changes do not require code changes.
CLINTCAL_API_VERSION=2026-02-25

# MCP server
CLINTCAL_MCP_TRANSPORT=stdio
CLINTCAL_MCP_NAME=clintware-scheduling

# Cal.diy application secrets/configuration are intentionally NOT stored here.
# Copy the pinned upstream .env.example into the runtime checkout and provide real secrets there.
# Required production integrations include PostgreSQL, authentication secrets,
# Google Calendar OAuth credentials, and email delivery credentials.
