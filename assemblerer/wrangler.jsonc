{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clintware-assemblerer",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../public/tools/assemblerer"
