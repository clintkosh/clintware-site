{
  "schema": "clintware-instruction-manifest/v1",
  "version": 6,
  "repository": "clintkosh/clintware-site",
  "branch": "main",
  "refresh": {
    "on_session_start": true,
    "on_master_prompt_reference": true,
    "on_instruction_reference": true,
    "no_cached_assumption": true
  },
  "documents": [
    {
      "id": "catshadow-bootstrap",
      "path": "control-plane/instructions/CATSHADOW-DAV1D-CLINTWARE-BOOTSTRAP.md",
      "title": "CATShadow / D@V1D / Clintware Bootstrap",
      "kind": "bootstrap",
      "enabled": true,
      "required": true,
      "load_order": -20,
      "clients": [
        "*"
      ],
      "loader": "clintware_instruction_file_get"
    },
    {
      "id": "catshadow-persona",
      "path": "control-plane/instructions/CATSHADOW.md",
      "title": "CATShadow / D@V1D Persona",
      "kind": "persona",
      "enabled": true,
      "required": true,
      "load_order": -10,
      "clients": [
        "*"
      ],
      "loader": "clintware_instruction_file_get"
    },
    {
      "id": "clintware-expert-mode",
      "path": "control-plane/instructions/EXPERT-MODE.md",
      "title": "Clintware Expert Mode",
      "kind": "quality",
      "enabled": true,
      "required": true,
      "load_order": -5,
      "clients": [
        "*"
      ],
      "loader": "clintware_instruction_file_get"
    },
    {
      "id": "clintware-master-prompt",
      "path": "control-plane/MASTER-PROMPT.md",
      "title": "Clintware Universal Master Prompt",
      "kind": "core",
      "enabled": true,
      "required": true,
      "load_order": 0,
      "clients": [
        "*"
      ],
      "loader": "clintware_master_prompt_get"
    }
  ],
  "extension_root": "control-plane/instructions/",
  "notes": "MCP-capable clients load every enabled applicable document in load_order. The canonical execution contract is control-plane/MASTER-PROMPT.md via clintware_master_prompt_get; the bootstrap now verifies its complete numbered 1-30 operating contract and final autonomous-continuation directive. UNIVERSAL-LLM-ROUTING.md is supplemental and must never replace the canonical master. Universal order begins with the full CATShadow/D@V1D/Clintware bootstrap, then canonical CATSHADOW.md, then Expert Mode, then the master prompt."
}
