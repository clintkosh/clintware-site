{
  "product": "landtheplane",
  "environment": "production",
  "version": 3,
  "repo": {
    "owner": "clintkosh",
    "name": "clintware-site",
    "default_branch": "main",
    "read": true,
    "write_prefixes": [
      "landtheplane-worker/",
      "projects/landtheplane-cc/"
    ],
    "delete_prefixes": [
      "landtheplane-worker/",
      "projects/landtheplane-cc/"
    ],
    "allowed_workflows": [
      "deploy-landtheplane-worker.yml",
      "deploy-landtheplane-cc.yml"
    ],
    "identity": "clintkosh"
  },
  "dns": {
    "allowed_names": [
      "landtheplane.clintware.com",
      "cc.clintware.com"
    ]
  },
  "capabilities": [
    "repo.read:clintware-site",
    "repo.write:landtheplane-worker/**",
    "repo.write:projects/landtheplane-cc/**",
    "repo.delete:landtheplane-worker/**",
    "repo.delete:projects/landtheplane-cc/**",
    "repo.branch:create",
    "repo.branch:read",
    "repo.commit:status",
    "repo.workflow:dispatch",
    "repo.workflow:status",
    "deployment.read",
    "deployment.execute:landtheplane",
    "deployment.execute:landtheplane-cc",
    "dns.ensure:landtheplane.clintware.com",
    "dns.ensure:cc.clintware.com",
    "analytics.write:landtheplane",
    "analytics.read:landtheplane",
    "flow.read:landtheplane",
    "flow.write:landtheplane",
    "flow.run:landtheplane"
  ],
  "deny": [
    "research.invoke",
    "secrets.read",
    "secrets.export",
    "billing.manage",
    "repo.write:unrelated/**",
    "infrastructure.admin:*"
  ],
  "protected_paths": [
    ".github/workflows/",
    ".github/actions/",
    "control-plane/security/",
    "control-plane/policy/"
  ],
  "telemetry_namespace": "landtheplane"
}
