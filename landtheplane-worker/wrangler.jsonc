{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clintware-landtheplane",
  "main": "src/index.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "landtheplane.clintware.com", "custom_domain": true }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
