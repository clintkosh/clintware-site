generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Merchant {
  id            String         @id @default(cuid())
  shop          String         @unique
  installedAt   DateTime       @default(now())
  uninstalledAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  policies      CouponPolicy[]
  couponUses    CouponUse[]
  reviews       ReviewItem[]
}

model CouponPolicy {
  id                  String   @id @default(cuid())
  merchantId          String
  merchant            Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  couponCode          String
  couponKey           String
  minSignals          Int      @default(2)
  lookbackDays        Int      @default(365)
  allowedPreviousUses Int      @default(0)
  enabled             Boolean  @default(false)
  discountId          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([merchantId, couponKey])
}

model CouponUse {
  id             String   @id @default(cuid())
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderId        String
  couponKey      String
  emailKey       String?
  phoneKey       String?
  addressKey     String?
  usedAt         DateTime
  discountAmount Float?
  createdAt      DateTime @default(now())

  @@unique([merchantId, orderId, couponKey])
  @@index([merchantId, couponKey, usedAt])
}

model ReviewItem {
  id              String   @id @default(cuid())
  merchantId      String
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderId         String
  couponKey       String
  recommendation  String
  evidence        Json
  outcome         String?
  overrideAllowed Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([merchantId, createdAt])
}
