<Window
    x:Class="Clintware.QuillgeistLite.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Clintware Quillgeist Lite">
    <Grid Background="Transparent" Padding="14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="15" BorderBrush="#CC55DFFF" BorderThickness="2" Background="#22000000">
                    <TextBlock Text="Q" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Clintware™  ·  QUILLGEIST LITE" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Go Furthest.™" Foreground="#FF52DCF9" FontSize="11"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="STARTING" Foreground="#FF52DCF9" FontFamily="Cascadia Mono" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Background="#52030910" BorderBrush="#3045D8FF" BorderThickness="1" CornerRadius="10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <TextBlock x:Name="GuardianText" Text="GUARDIAN // CHECKING" Foreground="#FFE8F8FF" FontFamily="Cascadia Mono"/>
                    <TextBlock x:Name="RunnerText" Text="RUNNER // CHECKING" Foreground="#FF9FB8C7" FontFamily="Cascadia Mono"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Restart runner" Click="RestartRunner_Click" Background="#2200B7D8" Foreground="White"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#70000509" BorderBrush="#2845D8FF" BorderThickness="1" CornerRadius="10" Padding="8">
            <TextBox x:Name="LogBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Cascadia Mono"
                     FontSize="12"
                     Foreground="#FFEAF7FF"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"/>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox"
                     PlaceholderText="Message qq…"
                     FontFamily="Cascadia Mono"
                     Foreground="White"
                     Background="#6200060A"
                     BorderBrush="#4045D8FF"
                     KeyDown="InputBox_KeyDown"/>
            <Button Grid.Column="1" Content="Send" Click="Send_Click" MinWidth="74" Background="#CC007FA4" Foreground="White"/>
        </Grid>
    </Grid>
</Window>
