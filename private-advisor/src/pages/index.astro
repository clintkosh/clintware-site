---
const title = "Private Advisor | Clintware";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Define done once. Your private AI advisor helps you get there." />
  <title>{title}</title>
  <style>
    :root{color-scheme:dark;--bg:#07100d;--panel:#0d1814;--panel2:#111f19;--text:#f4f7f5;--muted:#a8b5ad;--line:#26352e;--accent:#d9ff67;--accent2:#8ef0c0;--danger:#ff8b8b}
    *{box-sizing:border-box}
    body{margin:0;background:radial-gradient(circle at top,#13251c 0,#07100d 42%);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;min-height:100vh}
    button,input,textarea{font:inherit}
    .shell{max-width:1180px;margin:auto;padding:28px 18px 64px}
    header{display:flex;justify-content:space-between;gap:20px;align-items:center;margin-bottom:42px}
    .brand{font-weight:800;letter-spacing:.04em}.privacy{font-size:.88rem;color:var(--accent2);border:1px solid #315244;padding:8px 12px;border-radius:999px}
    .hero{display:grid;grid-template-columns:1.25fr .75fr;gap:28px;align-items:center;margin-bottom:30px}
    h1{font-size:clamp(2.6rem,7vw,6.2rem);line-height:.93;margin:0 0 20px;letter-spacing:-.055em;max-width:900px}
    .lede{font-size:clamp(1.05rem,2vw,1.35rem);line-height:1.55;color:var(--muted);max-width:760px}
    .advisor{background:linear-gradient(145deg,#152a20,#0d1814);border:1px solid var(--line);border-radius:28px;padding:24px;min-height:310px;display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 25px 90px #0008}
    .orb{width:96px;height:96px;border-radius:50%;background:radial-gradient(circle at 36% 34%,#f5ffbc 0 5%,#9effc9 17%,#254c3b 52%,#0a130f 76%);box-shadow:0 0 55px #8ef0c044;margin-bottom:26px}
    .advisor strong{font-size:1.35rem}.advisor p{color:var(--muted);line-height:1.5}.status{font-size:.85rem;color:var(--accent2)}
    .grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.card{background:rgba(13,24,20,.94);border:1px solid var(--line);border-radius:22px;padding:22px}
    .card h2{margin:0 0 8px;font-size:1.25rem}.card p{color:var(--muted);line-height:1.5;margin-top:0}
    textarea,input{width:100%;background:#08110e;border:1px solid #304139;color:var(--text);border-radius:14px;padding:14px;outline:none}
    textarea{min-height:176px;resize:vertical}.small{min-height:110px}
    textarea:focus,input:focus{border-color:var(--accent2)}
    .actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
    button{border:0;border-radius:12px;padding:12px 15px;font-weight:750;cursor:pointer}
    .primary{background:var(--accent);color:#10150c}.secondary{background:#18261f;color:var(--text);border:1px solid #304139}.danger{background:#2a1717;color:#ffc7c7;border:1px solid #593030}
    .result{margin-top:18px;border-top:1px solid var(--line);padding-top:18px}.result-grid{display:grid;gap:12px}.result section{background:#09130f;border:1px solid #23352d;border-radius:14px;padding:14px}.result h3{margin:0 0 7px;font-size:.86rem;text-transform:uppercase;letter-spacing:.08em;color:var(--accent2)}.result ul{margin:.2rem 0;padding-left:1.2rem}.result li{margin:.35rem 0}
    .memory-row{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:end}.fine{font-size:.79rem;color:#84938b;line-height:1.45}.hidden{display:none}
    .scope{margin-top:16px;padding:12px;border-radius:12px;background:#0a1511;border:1px solid #284238;color:#bad0c4;font-size:.88rem}
    @media(max-width:820px){.hero,.grid{grid-template-columns:1fr}.advisor{min-height:230px}header{align-items:flex-start;flex-direction:column}h1{font-size:3.4rem}}
  </style>
</head>
<body>
<div class="shell">
  <header>
    <div class="brand">CLINTWARE / PRIVATE ADVISOR</div>
    <div class="privacy">Private by default · Nothing logged</div>
  </header>

  <section class="hero">
    <div>
      <h1>Define done once.</h1>
      <p class="lede">Talk naturally about what you need. Your advisor turns the conversation into a clear definition of done, the constraints that matter, and a plan that fits you. The more you choose to teach it, the better it can represent you without exposing your private context to everyone involved.</p>
    </div>
    <aside class="advisor">
      <div>
        <div class="orb" aria-hidden="true"></div>
        <strong>Your private advisor</strong>
        <p>“Tell me what you’re trying to make happen. It can be small, personal, technical, financial, family-related, or an entire company transformation.”</p>
      </div>
      <div class="status">● Local-first session active</div>
    </aside>
  </section>

  <section class="grid">
    <div class="card">
      <h2>1. Tell the story</h2>
      <p>Speak as if you were talking to someone who already understands you. Messy is fine.</p>
      <textarea id="story" placeholder="Example: We need to replace our fleet next year, but I care more about downtime, driver comfort and predictable maintenance than getting the lowest sticker price..."></textarea>
      <label class="fine" for="context">Optional private context to consider</label>
      <textarea class="small" id="context" placeholder="Preferences, past decisions, family/company context, non-negotiables, things you never want recommended again..."></textarea>
      <div class="actions">
        <button class="primary" id="define">Build my Definition of Done</button>
        <button class="secondary" id="voice">Start voice input</button>
      </div>
      <p class="fine" id="voiceStatus"></p>
    </div>

    <div class="card">
      <h2>2. Your Definition of Done</h2>
      <p>This first build uses a local extraction engine. Later versions can route the same privacy-scoped brief through the Clintware Control Plane for deeper reasoning and research.</p>
      <div id="empty" class="scope">Nothing leaves this page in v0. Build a brief to see the minimum context that would be safe to share with an execution agent or vendor.</div>
      <div id="result" class="result hidden"></div>
    </div>

    <div class="card">
      <h2>3. Private memory</h2>
      <p>Save what you want your advisor to remember. The browser encrypts it before storing it locally.</p>
      <div class="memory-row">
        <div>
          <label class="fine" for="passphrase">Private vault passphrase</label>
          <input id="passphrase" type="password" autocomplete="new-password" placeholder="Used only in this browser session" />
        </div>
        <button class="secondary" id="saveMemory">Encrypt & save</button>
      </div>
      <div class="actions">
        <button class="secondary" id="loadMemory">Unlock memory</button>
        <button class="danger" id="clearMemory">Clear memory</button>
      </div>
      <p class="fine" id="memoryStatus">No server account. No analytics. No transcript logging.</p>
    </div>

    <div class="card">
      <h2>4. Scoped handoff</h2>
      <p>Your private advisor should know you deeply. Everyone else should know only what is necessary to complete the current job.</p>
      <textarea class="small" id="handoff" readonly placeholder="Generate a Definition of Done first."></textarea>
      <div class="actions">
        <button class="secondary" id="copyHandoff">Copy safe brief</button>
        <button class="secondary" id="downloadBrief">Download project brief</button>
      </div>
      <p class="fine">This is the future boundary between your Private Self Layer and execution vendors, agents, consultants, contractors, or internal teams.</p>
    </div>
  </section>
</div>

<script>
  const $ = id => document.getElementById(id);
  let currentBrief = null;

  function splitThoughts(text){
    return text.split(/(?:\n+|[.!?]+\s+)/).map(x=>x.trim()).filter(x=>x.length>8);
  }

  function unique(items){ return [...new Set(items.map(x=>x.trim()).filter(Boolean))].slice(0,7); }

  function deriveBrief(story, context){
    const thoughts = splitThoughts(story);
    const ctx = splitThoughts(context);
    const constraintWords = /budget|under |over |must|need|cannot|can't|never|without|deadline|by |before|after|prefer|avoid|only|location|size|employees|users|vehicles|days|weeks|months|years|privacy|security/i;
    const outcomeWords = /want|need|goal|result|done|success|replace|build|buy|find|reduce|increase|improve|move|launch|hire|acquire|plan|create|fix/i;
    const constraints = unique([...thoughts,...ctx].filter(x=>constraintWords.test(x)));
    const outcomes = unique(thoughts.filter(x=>outcomeWords.test(x)));
    const evidence = unique(thoughts.filter(x=>/because|so that|measure|metric|prove|verify|test|uptime|cost|time|quality|comfort|retention|revenue|risk|downtime/i.test(x)));
    const preferences = unique(ctx.length ? ctx : thoughts.filter(x=>/prefer|like|dislike|care|important|avoid|never/i.test(x)));
    const goal = outcomes[0] || thoughts[0] || story.trim();
    return {
      goal,
      outcomes: outcomes.length ? outcomes : [goal],
      constraints: constraints.length ? constraints : ["Confirm budget, timing, non-negotiables and decision authority."],
      evidence: evidence.length ? evidence : ["Agree on measurable acceptance criteria before execution begins."],
      preferences,
      unknowns: [
        "What would make this feel like the wrong solution even if it technically works?",
        "What is the deadline or triggering event?",
        "What is the acceptable investment range?",
        "Who else must approve or live with the result?"
      ]
    };
  }

  function renderBrief(brief){
    const list = xs => "<ul>"+xs.map(x=>"<li>"+escapeHtml(x)+"</li>").join("")+"</ul>";
    $("result").innerHTML = `
      <div class="result-grid">
        <section><h3>Primary outcome</h3><div>${escapeHtml(brief.goal)}</div></section>
        <section><h3>Definition of done</h3>${list(brief.outcomes)}</section>
        <section><h3>Constraints / non-negotiables</h3>${list(brief.constraints)}</section>
        <section><h3>How we will know it worked</h3>${list(brief.evidence)}</section>
        ${brief.preferences.length ? `<section><h3>Private preferences considered</h3>${list(brief.preferences)}</section>` : ""}
        <section><h3>Questions before execution</h3>${list(brief.unknowns)}</section>
      </div>`;
    $("result").classList.remove("hidden");
    $("empty").classList.add("hidden");

    const handoff = [
      "SCOPED EXECUTION BRIEF",
      "",
      "Outcome: "+brief.goal,
      "",
      "Definition of Done:",
      ...brief.outcomes.map(x=>"• "+x),
      "",
      "Constraints:",
      ...brief.constraints.map(x=>"• "+x),
      "",
      "Acceptance Evidence:",
      ...brief.evidence.map(x=>"• "+x),
      "",
      "Privacy boundary: Do not infer, request, retain, or reuse unrelated personal context. Use this brief only for this task."
    ].join("\n");
    $("handoff").value = handoff;
  }

  function escapeHtml(value){
    return value.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
  }

  $("define").addEventListener("click",()=>{
    const story=$("story").value.trim();
    if(!story){ $("story").focus(); return; }
    currentBrief=deriveBrief(story,$("context").value.trim());
    renderBrief(currentBrief);
  });

  let recognition;
  $("voice").addEventListener("click",()=>{
    const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
    if(!SR){ $("voiceStatus").textContent="Voice transcription is not available in this browser. Nothing was uploaded."; return; }
    if(recognition){ recognition.stop(); recognition=null; $("voiceStatus").textContent="Voice input stopped."; return; }
    recognition=new SR(); recognition.continuous=true; recognition.interimResults=true; recognition.lang="en-US";
    recognition.onresult=e=>{
      let finalText="";
      for(let i=e.resultIndex;i<e.results.length;i++) if(e.results[i].isFinal) finalText+=e.results[i][0].transcript+" ";
      if(finalText) $("story").value+=($("story").value?" ":"")+finalText.trim();
    };
    recognition.onend=()=>{ recognition=null; $("voiceStatus").textContent="Voice input stopped."; };
    recognition.start(); $("voiceStatus").textContent="Listening through your browser's speech-recognition capability…";
  });

  function bytesToB64(bytes){ return btoa(String.fromCharCode(...bytes)); }
  function b64ToBytes(s){ return Uint8Array.from(atob(s),c=>c.charCodeAt(0)); }
  async function keyFromPass(pass,salt){
    const material=await crypto.subtle.importKey("raw",new TextEncoder().encode(pass),"PBKDF2",false,["deriveKey"]);
    return crypto.subtle.deriveKey({name:"PBKDF2",salt,iterations:250000,hash:"SHA-256"},material,{name:"AES-GCM",length:256},false,["encrypt","decrypt"]);
  }
  async function encrypt(data,pass){
    const salt=crypto.getRandomValues(new Uint8Array(16)),iv=crypto.getRandomValues(new Uint8Array(12));
    const key=await keyFromPass(pass,salt);
    const cipher=await crypto.subtle.encrypt({name:"AES-GCM",iv},key,new TextEncoder().encode(JSON.stringify(data)));
    return {v:1,salt:bytesToB64(salt),iv:bytesToB64(iv),cipher:bytesToB64(new Uint8Array(cipher))};
  }
  async function decrypt(blob,pass){
    const key=await keyFromPass(pass,b64ToBytes(blob.salt));
    const plain=await crypto.subtle.decrypt({name:"AES-GCM",iv:b64ToBytes(blob.iv)},key,b64ToBytes(blob.cipher));
    return JSON.parse(new TextDecoder().decode(plain));
  }

  $("saveMemory").addEventListener("click",async()=>{
    const pass=$("passphrase").value;
    if(!pass){ $("memoryStatus").textContent="Enter a passphrase first."; return; }
    const data={story:$("story").value,context:$("context").value,brief:currentBrief,savedAt:new Date().toISOString()};
    try{
      localStorage.setItem("clintware.privateAdvisor.v0",JSON.stringify(await encrypt(data,pass)));
      $("memoryStatus").textContent="Encrypted memory saved locally in this browser.";
    }catch{ $("memoryStatus").textContent="Could not save encrypted local memory."; }
  });

  $("loadMemory").addEventListener("click",async()=>{
    const pass=$("passphrase").value,raw=localStorage.getItem("clintware.privateAdvisor.v0");
    if(!raw){ $("memoryStatus").textContent="No local memory found."; return; }
    try{
      const data=await decrypt(JSON.parse(raw),pass);
      $("story").value=data.story||""; $("context").value=data.context||""; currentBrief=data.brief||null;
      if(currentBrief) renderBrief(currentBrief);
      $("memoryStatus").textContent="Private memory unlocked locally.";
    }catch{ $("memoryStatus").textContent="Could not unlock memory. Check the passphrase."; }
  });

  $("clearMemory").addEventListener("click",()=>{
    localStorage.removeItem("clintware.privateAdvisor.v0");
    $("memoryStatus").textContent="Local encrypted memory cleared.";
  });

  $("copyHandoff").addEventListener("click",async()=>{
    if(!$("handoff").value) return;
    await navigator.clipboard.writeText($("handoff").value);
    $("copyHandoff").textContent="Copied";
    setTimeout(()=>$("copyHandoff").textContent="Copy safe brief",1200);
  });

  $("downloadBrief").addEventListener("click",()=>{
    const text=$("handoff").value;
    if(!text) return;
    const blob=new Blob([text],{type:"text/plain;charset=utf-8"});
    const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="definition-of-done.txt";a.click();URL.revokeObjectURL(a.href);
  });
</script>
</body>
</html>
