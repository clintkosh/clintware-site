{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clintware-venture-pages",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "quillgeist.clintware.com", "custom_domain": true },
    { "pattern": "promptiris.clintware.com", "custom_domain": true },
    { "pattern": "orgsynapse.clintware.com", "custom_domain": true },
    { "pattern": "portability.clintware.com", "custom_domain": true }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
