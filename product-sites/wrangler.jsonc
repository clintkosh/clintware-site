{
  "name": "clintware-product-sites",
  "main": "src/with-analytics.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "quillgeist.clintware.com", "custom_domain": true },
    { "pattern": "shouldersoldier.clintware.com", "custom_domain": true },
    { "pattern": "buyerorigin.clintware.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
