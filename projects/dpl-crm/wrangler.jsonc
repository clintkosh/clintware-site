{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"clintware-dpl-crm",
  "main":"src/index.js",
  "compatibility_date":"2026-09-22",
  "compatibility_flags":["nodejs_compat"],
  "assets":{"directory":"./public","binding":"ASSETS","run_worker_first":true},
  "durable_objects":{"bindings":[{"name":"CRM","class_name":"DPLCRM"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["DPLCRM"]}],
  "services":[{"binding":"CONTROL_PLANE","service":"clintware-control-plane"}],
  "observability":{"enabled":true},
  "vars":{"CRM_ANALYTICS_MODE":"first-party-control-plane"}
}
