{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "PRODUCT_WORKER_NAME",
  "main": "src/index.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "PRODUCT_DOMAIN", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
