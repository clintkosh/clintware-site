{
  "name": "clintware-brocomoapp",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "brocomoapp.clintware.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
