{
  "name": "clintware-blog-newsletter",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "newsletter.clintware.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "PUBLIC_ENDPOINT": "https://newsletter.clintware.com",
    "SITE_URL": "https://www.clintware.com",
    "FROM_EMAIL": "Clintware <hello@clintware.com>",
    "REPLY_TO": "hello@clintware.com",
    "ALLOWED_ORIGINS": "https://www.clintware.com,https://clintware.com",
    "RESEND_API_BASE_URL": "https://api.resend.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SUBSCRIBERS",
        "class_name": "SubscriberRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SubscriberRegistry"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
