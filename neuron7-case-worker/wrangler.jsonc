{
  "name": "clintware-neuron7-case",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "n7.clintware.com",
      "custom_domain": true
    },
    {
      "pattern": "n7case.clintware.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
